<mujoco model="scene">
    <include file="robot.xml" />
    <option gravity="0 0 -9.81"/>
    <!-- njmax/nconmax raised to prevent crashing during complex contact -->
    <size njmax="3000" nconmax="1000"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <visual>
        <global offwidth="1080" offheight="1080"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.655 0.627 0.580" rgb2=" 0.655 0.627 0.580" markrgb="0.655 0.627 0.580" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.000" />
        <mesh name="cube_mesh" file="cube.stl"/>

        <!-- One texture/material pair per AprilTag (tag36h11 family, IDs 0-5) -->
        <!-- Bottom face -->
        <texture name="tag_tex_0" type="2d" file="tag36h11_00.png"/>
        <material name="tag_mat_0" texture="tag_tex_0" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/>

        <!-- Right (+X) face -->
        <texture name="tag_tex_1" type="2d" file="tag36h11_01.png"/>
        <material name="tag_mat_1" texture="tag_tex_1" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/>

        <!-- Left (-X) face -->
        <texture name="tag_tex_2" type="2d" file="tag36h11_02.png"/>
        <material name="tag_mat_2" texture="tag_tex_2" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/>

        <!-- Front (+Y) face -->
        <texture name="tag_tex_3" type="2d" file="tag36h11_03.png"/>
        <material name="tag_mat_3" texture="tag_tex_3" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/>

        <!-- Back (-Y) face -->
        <texture name="tag_tex_4" type="2d" file="tag36h11_04.png"/>
        <material name="tag_mat_4" texture="tag_tex_4" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/>

        <!-- Top (+Z) face this is the original tag, position kept unchanged -->
        <texture name="tag_tex_5" type="2d" file="tag36h11_05.png"/>
        <material name="tag_mat_5" texture="tag_tex_5" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/>
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 -0.2" type="plane" material="groundplane" />

        <body name="cube" pos="-0.07 0.029 0.03" quat="1.0 0.0 0.0 0.0">
            <freejoint name ="cube_joint"/>

            <!-- Explicit inertial override. Without this, MuJoCo auto-computes
                 mass/inertia by integrating over the actual cube_mesh triangles
                 (inertiafromgeom, default). The mesh's own bounding box is
                 off-origin (y in [-0.06,-0.01], center -0.035 - same offset
                 as CUBE_CENTER_LOCAL in twist_test.py), and minor asymmetries
                 in the STL (rounded corners, uneven wall thickness, etc.)
                 were producing a computed inertia tensor with non-zero
                 off-diagonal terms - visually, a rotated/misaligned inertia
                 box relative to the actual cube geometry. This assumes a
                 uniform-density 0.05 x 0.05 x 0.05 m solid cube:
                 diaginertia = m*a^2/6 with m=0.071 kg, a=0.05 m.
                 If the real cube has genuinely asymmetric internal mass
                 (electronics, uneven infill, etc.), this override trades
                 sim-to-real fidelity for a clean/predictable tensor - revisit
                 if that matters for your use case. -->
            <inertial pos="0 -0.035 0" mass="0.051" diaginertia="2.958e-05 2.958e-05 2.958e-05"/>

            <geom
                name="target_cube_geom"
                type="mesh"
                mesh="cube_mesh"
                contype="5"
                conaffinity="5"
                rgba="1 1 1 1"/>

            <!-- ===================== 6 face tags ===================== -->

            <!-- FACE: Top (+Z) — tag 5 — UNCHANGED, this was the original tag and its position is kept exactly as-is -->
            <!-- White backing plate: same pos/orientation, wider in-plane, slightly thinner so the tag sticks out past it (no z-fighting). Gives the tag a white quiet-zone border for AprilTag detection. -->
            <geom name="tag_backing_5" type="box" pos="-0.02 -0.035 0.025" size="0.0075 0.0075 0.00005" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <geom name="tag_number_5" type="box" pos="-0.02 -0.035 0.025" size="0.005 0.005 0.0001" material="tag_mat_5" rgba="1 1 1 1" contype="0" conaffinity="0"/>

            <!-- Cube (from cube.stl bounding box): x in [-0.025,0.025], y in [-0.06,-0.01] (center -0.035), z in [-0.025,0.025] -->
            <!-- All 5 new tags placed in a corner of their face (both in-plane axes offset, not just one) so none read as centered -->
            <!-- FACE: Bottom (-Z) — tag 0 — no rotation needed (thin dimension already along local Z) -->
            <geom name="tag_backing_0" type="box" pos="-0.02 -0.035 -0.025" size="0.0075 0.0075 0.00005" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <geom name="tag_number_0" type="box" pos="-0.02 -0.035 -0.025" size="0.005 0.005 0.0001" material="tag_mat_0" rgba="1 1 1 1" contype="0" conaffinity="0"/>

            <!-- FACE: Right (+X) — tag 1 — rotated +90 deg about Y so the thin dimension (local Z) points along +X -->
            <geom name="tag_backing_1" type="box" pos="0.025 -0.055 -0.0" size="0.0075 0.0075 0.00005" quat="0.7071068 0 0.7071068 0" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <geom name="tag_number_1" type="box" pos="0.025 -0.055 -0.0" size="0.005 0.005 0.0001" quat="0.7071068 0 0.7071068 0" material="tag_mat_1" rgba="1 1 1 1" contype="0" conaffinity="0"/>

            <!-- FACE: Left (-X) — tag 2 — rotated -90 deg about Y so the thin dimension (local Z) points along -X -->
            <geom name="tag_backing_3" type="box" pos="-0.025 -0.015 -0.0" size="0.0075 0.0075 0.00005" quat="0.7071068 0 -0.7071068 0" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <geom name="tag_number_3" type="box" pos="-0.025 -0.015 -0.0" size="0.005 0.005 0.0001" quat="0.7071068 0 -0.7071068 0" material="tag_mat_2" rgba="1 1 1 1" contype="0" conaffinity="0"/>

            <!-- FACE: Front (+Y) — tag 3 — rotated -90 deg about X so the thin dimension (local Z) points along +Y -->
            <geom name="tag_backing_4" type="box" pos="0.02 -0.01 -0.0" size="0.0075 0.0075 0.00005" quat="0.7071068 -0.7071068 0 0" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <geom name="tag_number_4" type="box" pos="0.02 -0.01 -0.0" size="0.005 0.005 0.0001" quat="0.7071068 -0.7071068 0 0" material="tag_mat_4" rgba="1 1 1 1" contype="0" conaffinity="0"/>

            <!-- FACE: Back (-Y) — tag 4 — rotated +90 deg about X so the thin dimension (local Z) points along -Y -->
            <geom name="tag_backing_2" type="box" pos="-0.02 -0.06 -0.0" size="0.0075 0.0075 0.00005" quat="0.7071068 0.7071068 0 0" rgba="1 1 1 1" contype="0" conaffinity="0"/>
            <geom name="tag_number_2" type="box" pos="-0.02 -0.06 -0.0" size="0.005 0.005 0.0001" quat="0.7071068 0.7071068 0 0" material="tag_mat_2" rgba="1 1 1 1" contype="0" conaffinity="0"/>

        </body>
    </worldbody>

    <worldbody>
        <camera name="tracking_camera" pos="-0.276 0.149 0.221" xyaxes="-0.476 -0.880 -0.000 0.705 -0.381 0.598"/>

    </worldbody>
</mujoco>
